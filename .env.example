# Copy to .env for local runs (.env is gitignored). See AGENTS.md.

# HTTP listener (streamable HTTP at /mcp, liveness at /healthz, dependency
# readiness at /readyz)
PRINTABLE_HTTP_HOST=127.0.0.1
PRINTABLE_HTTP_PORT=8000
# Required on every /mcp request. Production obtains this shared gateway
# credential from Infisical; use exactly 64 lowercase hexadecimal characters.
#PRINTABLE_MCP_BEARER=

# Blender add-on bridge. Local Blender defaults to loopback; production uses
# the private `blender` service DNS name.
BLENDER_HOST=127.0.0.1
BLENDER_PORT=9876
# Configure a separate background endpoint to enable isolated durable rendering.
#PRINTABLE_RENDER_WORKER_HOST=blender-render-worker
#PRINTABLE_RENDER_WORKER_PORT=9876

# Headless bridge runtime (the container overrides bind to 0.0.0.0 on its
# private network). CPU is the safe local/CI default; production uses OPTIX.
PRINTABLE_BLENDER_BIND=127.0.0.1
PRINTABLE_BLENDER_RENDER_DEVICE=CPU
# UI mode starts a private display; background remains the default.
PRINTABLE_BLENDER_MODE=background
PRINTABLE_BLENDER_UI_BACKEND=software
# Set render_worker only in the separate background worker container.
PRINTABLE_BLENDER_ROLE=live
# Seconds: request 0.1-3600, shutdown 0.1-300, heartbeat 0.05-60.
PRINTABLE_BLENDER_REQUEST_TIMEOUT_SECONDS=120
PRINTABLE_BLENDER_SHUTDOWN_TIMEOUT_SECONDS=10
PRINTABLE_BLENDER_QUEUE_CAPACITY=16
PRINTABLE_BLENDER_MAX_CONNECTIONS=32
PRINTABLE_BLENDER_MAX_FRAME_BYTES=52428800
PRINTABLE_BLENDER_HEARTBEAT_SECONDS=1
#PRINTABLE_BLENDER_STATE_DIR=/run/printable-blender

# Workspace confinement. Unset = unconfined dev mode (workspace tools
# disabled). PRINTABLE_BLENDER_WORKSPACE_ROOT maps the Rust root onto the path
# Blender sees and requires PRINTABLE_WORKSPACE_ROOT. Both production
# containers use /workspace, so the mapping is an identity.
#PRINTABLE_WORKSPACE_ROOT=/workspace
#PRINTABLE_BLENDER_WORKSPACE_ROOT=/workspace

# OpenSCAD CLI override (otherwise discovered on PATH and well-known paths)
#OPENSCAD_BIN=/usr/local/bin/openscad-headless

# Max concurrent OpenSCAD subprocesses
#PRINTABLE_SCAD_CONCURRENCY=2

# Durable still/turntable/animation jobs. FFmpeg defaults to PATH lookup; the
# production image pins the packaged binary. Queue depth counts all queued and
# running jobs process-wide.
#FFMPEG_BIN=/usr/bin/ffmpeg
#PRINTABLE_RENDER_JOB_QUEUE_DEPTH=16

# Exact assembly CSG runs in a disposable sibling process. The address-space
# budget contains generated boolean topology without imposing a work timeout.
# Override the binary only for nonstandard local installations.
#PRINTABLE_GEOMETRY_WORKER_BIN=/usr/local/bin/printable-geometry-worker
#PRINTABLE_GEOMETRY_WORKER_MEMORY_MIB=1024

# DNS-rebinding Host-header allowlist for the HTTP listener. Container
# deployments must include the Docker DNS name in bare and host:port form.
#PRINTABLE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
