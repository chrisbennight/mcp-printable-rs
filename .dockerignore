# Keep the build context lean. Each stage copies only the paths it names, so
# exclude only the large or irrelevant trees — never the crates, Cargo
# manifests, docs, or README files that Cargo metadata and runtime guidance may
# reference.
.git
.gitea
.worktrees
target
**/target
**/__pycache__
**/*.pyc
addon/tests
evals
.claude
.dev
**/.dev
.cargo
**/.env
**/.env.*
!**/.env.example
