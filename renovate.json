{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "cargo",
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins declared under a renovate hint comment. Adjacent checksums require independent verification when their version changes.",
      "fileMatch": [
        "^\\.github/workflows/.*\\.ya?ml$",
        "^rust-toolchain\\.toml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s*\\n\\s*(?:[A-Z0-9_]+|channel)\\s*[:=]\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "ignorePaths": [
    ".gitea/**"
  ]
}
