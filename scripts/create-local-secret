#!/usr/bin/env python3
"""Create the local Compose credential without printing its value."""

import os
from pathlib import Path
import secrets
import stat


def create(directory: Path) -> None:
    directory.mkdir(mode=0o700, exist_ok=True)
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    descriptor = os.open(directory, flags)
    try:
        info = os.fstat(descriptor)
        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise ValueError("credential directory must be owned by you with mode 0700")
        output = os.open(
            "mcp-bearer", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o400, dir_fd=descriptor,
        )
        try:
            with os.fdopen(output, "wb") as stream:
                stream.write((secrets.token_hex(32) + "\n").encode("ascii"))
                stream.flush()
                os.fsync(stream.fileno())
                # Compose bind-mounts the file without changing its host ownership.
                # The containing directory protects host access; UID 10001 must read it.
                os.fchmod(stream.fileno(), 0o444)
        except BaseException:
            os.unlink("mcp-bearer", dir_fd=descriptor)
            raise
    finally:
        os.close(descriptor)


if __name__ == "__main__":
    try:
        create(Path(__file__).resolve().parent.parent / ".dev")
    except FileExistsError:
        raise SystemExit("Credential already exists; it was preserved.") from None
    except (OSError, ValueError):
        raise SystemExit("Could not create credential; check .dev ownership and permissions.") from None
    print("Created .dev/mcp-bearer. Keep .dev private and out of backups shared with others.")
